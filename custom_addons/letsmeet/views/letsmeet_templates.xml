<odoo>
    <template id="SlotPicker" name="LetsMeet Slot Picker">
        <div class="letsmeet-wrapper">
            <h2>Select a Time Slot</h2>
            <t t-if="state.loading">
                <p>Loading available slots...</p>
            </t>
            <t t-else="">
                <div class="slot-grid">
                    <t t-foreach="state.slots" t-as="slot">
                        <button t-on-click="() => selectSlot(slot)"
                            t-att-class="'slot-button ' + (state.selectedSlot && state.selectedSlot.id === slot.id ? 'selected' : '')">
                            <t t-esc="slot.start" /> - <t t-esc="slot.end" />
                        </button>
                    </t>
                </div>
                <div class="booking-form">
                    <input type="text" id="name" placeholder="Your Name" />
                    <input type="email" id="email" placeholder="Your Email" />
                    <button t-on-click="confirmBooking">Confirm Booking</button>
                </div>
            </t>
        </div>
    </template>


    <!-- Website Page Template -->
    <template id="letsmeet_schedule" name="LetsMeet Scheduling Page" page="letsmeet/schedule">
        <t t-call="website.layout">
            <div class="container mt-5">
                <h1 class="text-center">Schedule a Meeting</h1>
                <div id="letsmeet-slot-picker"></div>
            </div>
        </t>
    </template>
</odoo>